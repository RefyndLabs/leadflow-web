# ── Leadflow API (server-side only; never exposed to the browser) ───────────
# Local dev: use 127.0.0.1 rather than localhost (slow resolution on Windows).
API_URL=http://127.0.0.1:8000

# ── Session ────────────────────────────────────────────────────────────────
# Encrypts the httpOnly session cookie. At least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Set to "false" only when serving the production build over plain http locally.
SESSION_COOKIE_SECURE=

# Extra origins (comma separated) allowed to make state-changing requests.
# The app's own host is always allowed.
ALLOWED_ORIGINS=

# ── Error tracking (optional) ──────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
